# WeatherWise Analytics Environment Configuration
# Default local MongoDB connection
MONGO_URI=mongodb://localhost:27017/

# Database and collection names
MONGO_DB_NAME=weatherwise_db
MONGO_COLLECTION_NAME=daily_weather

# Connection timeout in milliseconds (short timeout for responsive offline fallback)
MONGO_TIMEOUT_MS=3000

# Reproducible random seed
RANDOM_SEED=42

# Application Port
STREAMLIT_SERVER_PORT=8501
